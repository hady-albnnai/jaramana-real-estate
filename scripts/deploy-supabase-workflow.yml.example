# ═══════════════════════════════════════════════════════════════════
# مثال موحّد للصق عبر واجهة GitHub (حساب المالك):
#   الريبو → Add file → Create new file → الاسم:
#     .github/workflows/ci-and-deploy.yml
#   → الصق محتوى هذا الملف → Commit directly to the arena branch.
# يحتوي 3 وظائف:
#   1) analyze-debug: يطبع أخطاء flutter analyze/test كـ annotations
#      (سجلات GitHub Actions محجوبة عن بيئة الوكيل).
#   2) verify-live: فحص نسخة الدالتين الحيتين بلا أي سر (مفتاح anon عام).
#   3) deploy: نشر كامل عند التشغيل اليدوي — يتطلب السر SUPABASE_PAT
#      في Settings → Secrets and variables → Actions.
# ═══════════════════════════════════════════════════════════════════
name: CI and Deploy

on:
  push:
    branches: [main, 'arena/**']
  workflow_dispatch:
    inputs:
      apply_migrations:
        description: 'تطبيق تعديلات SQL 2026_08_19 (idempotent — آمنة)'
        type: boolean
        default: true
      cleanup_test_user:
        description: 'حذف بيانات مستخدم الاختبار (خطر — فقط عند الرغبة)'
        type: boolean
        default: false
      test_user_name:
        description: 'اسم مستخدم الاختبار المراد حذف بياناته'
        type: string
        default: 'هناء العيسمي'

jobs:
  # ── 1) تشخيص flutter analyze/test عبر annotations ──
  analyze-debug:
    name: تشخيص flutter analyze
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true
      - name: Version
        run: |
          V=$(flutter --version | tr '\n' ' ')
          echo "::notice title=flutter-version::$V"
      - name: Pub get
        run: flutter pub get
      - name: Analyze (to annotations)
        run: |
          flutter analyze 2>&1 | tee /tmp/an.txt || true
          python3 - <<'PY'
          lines = [l for l in open('/tmp/an.txt', encoding='utf-8', errors='replace').read().splitlines() if l.strip()]
          if not lines:
              print("::notice title=flutter-analyze::EMPTY OUTPUT")
              raise SystemExit(0)
          print("::notice title=flutter-analyze-summary::TOTAL_LINES=%d | %s" % (len(lines), lines[-1][:400]))
          n, chunk = 9, (len(lines) + 8) // 9
          for i in range(n):
              part = lines[i*chunk:(i+1)*chunk]
              if not part: break
              print("::error title=flutter-analyze-%d::%s" % (i, " | ".join(part)[:60000]))
          PY
      - name: Test (to annotations)
        run: |
          flutter test 2>&1 | tee /tmp/tt.txt || true
          python3 - <<'PY'
          lines = [l for l in open('/tmp/tt.txt', encoding='utf-8', errors='replace').read().splitlines() if l.strip()]
          if not lines:
              print("::notice title=flutter-test::EMPTY OUTPUT")
              raise SystemExit(0)
          print("::notice title=flutter-test-summary::TOTAL_LINES=%d | %s" % (len(lines), lines[-1][:400]))
          n, chunk = 9, (len(lines) + 8) // 9
          for i in range(n):
              part = lines[i*chunk:(i+1)*chunk]
              if not part: break
              print("::error title=flutter-test-%d::%s" % (i, " | ".join(part)[:60000]))
          PY

  # ── 2) فحص حي للدالتين على السيرفر (بلا أسرار إطلاقاً) ──
  verify-live:
    name: فحص الدالتين الحيتين
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Probe admin-dashboard + legal-actions
        run: |
          ANON=$(grep -oE "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9._-]+" lib/core/constants/supabase_constants.dart | head -1)
          BASE=https://vsgkgnjtebjxyqwpuopz.supabase.co
          BODY_AD='{"action":"users_by_ids","admin_uid":"00000000-0000-0000-0000-000000000000","staff_session_token":"bogus","ids":[]}'
          BODY_LA='{"action":"get_chat_session_v2","user_uid":"00000000-0000-0000-0000-000000000000","staff_session_token":"bogus","consultation_id":"00000000-0000-0000-0000-000000000000"}'
          AD=$(curl -sS --max-time 60 -X POST "$BASE/functions/v1/admin-dashboard" \
            -H "apikey: $ANON" -H "Authorization: Bearer $ANON" -H "Content-Type: application/json" \
            -d "$BODY_AD")
          LA=$(curl -sS --max-time 60 -X POST "$BASE/functions/v1/legal-actions" \
            -H "apikey: $ANON" -H "Authorization: Bearer $ANON" -H "Content-Type: application/json" \
            -d "$BODY_LA")
          echo "::notice title=admin-dashboard-probe::$(echo "$AD" | head -c 800)"
          echo "::notice title=legal-actions-probe::$(echo "$LA" | head -c 800)"
          case "$AD" in
            *UNKNOWN_ACTION*)
              echo "::error title=admin-dashboard-version::OLD - users_by_ids غير منشورة (الإصدار الحي قديم)";;
            *"Function not found"*)
              echo "::error title=admin-dashboard-version::MISSING - الدالة غير موجودة على السيرفر";;
            *STAFF_SESSION_REQUIRED*|*INVALID_STAFF_SESSION*)
              echo "::notice title=admin-dashboard-version::NEW - users_by_ids موجودة (وصل الطلب إلى حراس الجلسة)";;
            *)
              echo "::notice title=admin-dashboard-version::UNCLASSIFIED - راجع الـ probe أعلاه";;
          esac

  # ── 3) النشر الكامل (تشغيل يدوي فقط — يتطلب السر SUPABASE_PAT) ──
  deploy:
    name: نشر Supabase (SQL + دوال)
    runs-on: ubuntu-latest
    if: github.event_name == 'workflow_dispatch'
    steps:
      - uses: actions/checkout@v4
      - name: معلومات النسخ الحية قبل النشر
        env:
          SUPABASE_PAT: ${{ secrets.SUPABASE_PAT }}
        run: |
          for slug in admin-dashboard legal-actions; do
            INFO=$(curl -sS --max-time 60 -H "Authorization: Bearer $SUPABASE_PAT" \
              "https://api.supabase.com/v1/projects/vsgkgnjtebjxyqwpuopz/functions/$slug")
            echo "::notice title=pre-deploy-$slug::$(echo "$INFO" | head -c 800)"
          done
      - name: تشغيل scripts/deploy_supabase.sh
        env:
          SUPABASE_PROJECT_REF: vsgkgnjtebjxyqwpuopz
          SUPABASE_PAT: ${{ secrets.SUPABASE_PAT }}
          APPLY_MIGRATIONS: ${{ inputs.apply_migrations }}
          CLEANUP: ${{ inputs.cleanup_test_user }}
          TEST_USER_NAME: ${{ inputs.test_user_name }}
          DEPLOY_FUNCTIONS: 'true'
        run: bash scripts/deploy_supabase.sh
      - name: معلومات النسخ الحية بعد النشر
        env:
          SUPABASE_PAT: ${{ secrets.SUPABASE_PAT }}
        run: |
          for slug in admin-dashboard legal-actions; do
            INFO=$(curl -sS --max-time 60 -H "Authorization: Bearer $SUPABASE_PAT" \
              "https://api.supabase.com/v1/projects/vsgkgnjtebjxyqwpuopz/functions/$slug")
            echo "::notice title=post-deploy-$slug::$(echo "$INFO" | head -c 800)"
          done
